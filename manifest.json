{
  "manifest_version": 3,
  "name": "Zen Essentials in Chrome",
  "short_name": "Zen Essentials",
  "version": "1.1.13",
  "description": "Pinned tabs shared by every window, a new tab overlay that opens nothing until you pick, and one click to clear the other tabs.",
  "minimum_chrome_version": "127",
  "permissions": [
    "tabs",
    "storage",
    "favicon",
    "activeTab",
    "scripting",
    "search"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Close the other tabs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "open-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open a new tab"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/overlay.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_permissions": [
    "history",
    "bookmarks"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
